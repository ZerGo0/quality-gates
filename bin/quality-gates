#!/usr/bin/env bash

set -euo pipefail

readonly TOOL_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
readonly SLOPO_DIR="$TOOL_DIR/slopo"
readonly INSTALL_STAMP="$TOOL_DIR/.install-stamp"
readonly CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/quality-gates"
readonly REPOSITORY_KEY_LENGTH=16

usage() {
  cat <<'EOF'
Usage: quality-gates <command>

Commands:
  run [--base <ref> | --all]                     Run the quality gates on the current changes
  clear-cache [--all]                            Remove the cache of this repository, or of all repositories
  cleanup [--check] [--changes [--base <ref>]]   Replace AI typography in repository files
  setup                                          Install llama.cpp and the SlopO embedding model

Changes are the files that differ from the merge-base with the default branch,
or the uncommitted changes on main and master. --base <ref> compares with <ref> instead.
run --all checks the entire repository. Caches unused for 30 days, or whose
repository no longer exists, are removed automatically.
EOF
}

die() {
  printf 'quality-gates: %s\n' "$*" >&2
  exit 1
}

lock_hash() {
  cat "$TOOL_DIR/pnpm-lock.yaml" "$SLOPO_DIR/uv.lock" | shasum -a 256
}

ensure_dependencies() {
  local expected
  expected="$(lock_hash)"
  if [[ -f "$INSTALL_STAMP" && "$(<"$INSTALL_STAMP")" == "$expected" ]]; then
    return
  fi
  printf 'quality-gates: installing dependencies\n' >&2
  (cd "$TOOL_DIR" && pnpm install --frozen-lockfile) >&2
  uv sync --locked --no-dev --project "$SLOPO_DIR" >&2
  printf '%s\n' "$expected" >"$INSTALL_STAMP"
}

enter_repository() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || die 'run this command inside a Git repository'
  cd "$root"
}

export_repository_cache() {
  local key
  key="$(printf '%s' "$PWD" | shasum -a 256 | cut -c "1-$REPOSITORY_KEY_LENGTH")"
  export QUALITY_GATES_REPOSITORY_CACHE="$CACHE_ROOT/repositories/$(basename "$PWD")-$key"
}

repository_cache() {
  python3 "$TOOL_DIR/scripts/gates/repository_cache.py" "$@"
}

export_change_base() {
  local resolved
  if [[ -n "$base" ]]; then
    export SLOPO_AUDIT_BASE="$base"
  fi
  printf 'quality-gates: base: ' >&2
  resolved="$(python3 "$SLOPO_DIR/resolve_git_base.py" --repository-root "$PWD")" || exit 2
  export QUALITY_GATES_BASE="${resolved#*$'\t'}"
}

command="${1:-}"
[[ $# -gt 0 ]] && shift

base=""
full_repository=false
arguments=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      [[ $# -ge 2 ]] || die '--base needs a Git ref'
      base="$2"
      shift 2
      ;;
    --base=*)
      base="${1#--base=}"
      shift
      ;;
    --all)
      full_repository=true
      shift
      ;;
    *)
      arguments+=("$1")
      shift
      ;;
  esac
done

case "$command" in
  run)
    [[ ${#arguments[@]} -eq 0 ]] || die "unknown option for run: ${arguments[0]}"
    [[ "$full_repository" == false || -z "$base" ]] || die '--all and --base cannot be combined'
    enter_repository
    ensure_dependencies
    export_repository_cache
    repository_cache prepare "$QUALITY_GATES_REPOSITORY_CACHE" "$PWD"
    if [[ "$full_repository" == true ]]; then
      exec python3 "$TOOL_DIR/scripts/gates/run_aislop.py" --all
    fi
    export_change_base
    exec python3 "$TOOL_DIR/scripts/gates/run_aislop.py"
    ;;
  clear-cache)
    [[ ${#arguments[@]} -eq 0 && -z "$base" ]] || die 'clear-cache accepts only --all'
    if [[ "$full_repository" == true ]]; then
      repository_cache clear-all "$CACHE_ROOT/repositories"
      exit
    fi
    enter_repository
    export_repository_cache
    repository_cache clear "$QUALITY_GATES_REPOSITORY_CACHE"
    ;;
  cleanup)
    [[ "$full_repository" == false ]] || die '--all is only for run; cleanup without --changes covers all files'
    enter_repository
    ensure_dependencies
    if [[ " ${arguments[*]-} " == *" --changes "* ]]; then
      export_change_base
    fi
    exec node "$TOOL_DIR/scripts/ai-cleanup.ts" ${arguments[@]+"${arguments[@]}"}
    ;;
  setup)
    ensure_dependencies
    exec "$TOOL_DIR/scripts/setup-slopo-llama-cpp.sh"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
